{
    "name": "pv-dictionary",
    "version": "0.2.0",
    "description": "PV_Dictionary — 線上英文生字字典（Express 5 + Supabase）",
    "main": "server.js",
    "type": "commonjs",
    "scripts": {
        "start": "node server.js",
        "seed": "node scripts/seed.js",
        "test": "node --test tests/*.test.js",
        "check:syntax": "node scripts/check-syntax.js",
        "check:browser": "node tests/browser/demo-check.js && node tests/browser/empty-start-check.js && node tests/browser/lang-check.js && node tests/browser/users-check.js",
        "check": "npm run check:syntax && npm test"
    },
    "keywords": [
        "dictionary",
        "vocabulary",
        "education"
    ],
    "author": "Rimuru",
    "license": "ISC",
    "engines": {
        "node": ">=22"
    },
    "dependencies": {
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "jsonwebtoken": "^9.0.3"
    }
}
