# Gary-Dictionary 環境變數範例（複製成 .env 後填值；.env 不進版控）

# 執行環境（production 會啟用 Secure cookie 與 fail-fast 檢查）
NODE_ENV=development

# 本機連接埠
PORT=3000

# JWT 簽章密鑰（production 必填；本機未設會用固定開發值並印警告）
JWT_SECRET=

# 資料層：json（Demo 預設，存 data/store.json）| supabase（PostgREST 相容後端；已完成，見下方）
DATA_BACKEND=json
DATA_FILE=data/store.json

# 站台網址（部署時填；用於 CORS／CSRF 來源白名單）
SITE_URL=
CORS_ALLOWED_ORIGINS=

# PostgREST 相容後端（DATA_BACKEND=supabase 時使用）
# ★ v0.10.0 起線上用的是 **Neon 的 Data API**（變數名沿用，因為 adapter 兩邊通用）：
#   SUPABASE_URL = https://<endpoint>.apirest.<region>.aws.neon.tech/<db>（不要帶 /rest/v1）
#   SUPABASE_SERVICE_ROLE_KEY = 用 scripts/neon-jwt.js 自簽的 JWT（Neon 沒有 JWT 一律 400）
#   切換／回滾：node scripts/switch-backend.js --status｜--to=neon｜--to=supabase｜--rotate-jwt｜--rollback
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Neon（v0.10.0 起）：切換工具會用這兩個值，非機密
NEON_DATA_API_URL=
NEON_JWT_AUDIENCE=gary-dictionary
# 簽 JWT 用的私鑰（PKCS#8 PEM 的 base64；由 node scripts/neon-jwt.js --make-keys 產生，永不進版控）
NEON_JWT_PRIVATE_KEY_B64=

# 種子帳號密碼（scripts/seed.js 讀取；未設會自動產生一組並只寫進 .env）
SEED_MANAGER_PASSWORD=
SEED_TEACHER_PASSWORD=
SEED_CLASS_REP_PASSWORD=
