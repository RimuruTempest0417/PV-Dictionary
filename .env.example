# PV_Dictionary 環境變數範例（複製成 .env 後填值；.env 不進版控）

# 執行環境（production 會啟用 Secure cookie 與 fail-fast 檢查）
NODE_ENV=development

# 本機連接埠
PORT=3000

# JWT 簽章密鑰（production 必填；本機未設會用固定開發值並印警告）
JWT_SECRET=

# 資料層：json（Demo 預設，存 data/store.json）| supabase（v0.1.0 實作）
DATA_BACKEND=json
DATA_FILE=data/store.json

# 站台網址（部署時填；用於 CORS／CSRF 來源白名單）
SITE_URL=
CORS_ALLOWED_ORIGINS=

# Supabase（DATA_BACKEND=supabase 時使用；v0.1.0）
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 種子帳號密碼（scripts/seed.js 讀取；未設會自動產生一組並只寫進 .env）
SEED_MANAGER_PASSWORD=
SEED_TEACHER_PASSWORD=
SEED_CLASS_REP_PASSWORD=
